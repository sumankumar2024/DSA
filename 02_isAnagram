        // method 2

        // use 26 size array

        if(s.length()!=t.length()) return false;

        int charCounts[] = new int[26];

        for(int i=0;i<s.length();i++){
            charCounts[s.charAt(i)-'a']++;
            charCounts[t.charAt(i)-'a']--;
        }

        // check if all counts balanced to 0
        for(int nums:charCounts){
            if(nums!=0){
                return false;
            }
        }

        return true;
